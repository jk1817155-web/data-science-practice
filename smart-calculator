
import tkinter as tk
import math

root = tk.Tk()
root.title("Smart Calculator")
root.geometry("360x540")
root.configure(bg="#202530")
root.resizable(False, False)

expression = ""

display = tk.Entry(
    root,
    font=("Arial", 24),
    justify="right",
    bg="#303846",
    fg="white",
    insertbackground="white",
    relief="flat",
    bd=10
)
display.pack(fill="x", padx=12, pady=18, ipady=12)


def press(value):
    global expression

    if value == "C":
        expression = ""
        display.delete(0, tk.END)

    elif value == "⌫":
        expression = expression[:-1]
        display.delete(0, tk.END)
        display.insert(0, expression)

    elif value == "=":
        try:
            expr = expression.replace("×", "*").replace("÷", "/")
            expr = expr.replace("%", "/100")

            allowed = {
                "__builtins__": {},
                "sqrt": math.sqrt,
                "pow": pow,
                "pi": math.pi
            }

            result = eval(expr, allowed, {})
            expression = str(result)

            display.delete(0, tk.END)
            display.insert(0, expression)

        except Exception:
            display.delete(0, tk.END)
            display.insert(0, "Invalid calculation")
            expression = ""

    elif value == "√":
        try:
            number = float(expression)
            result = math.sqrt(number)
            expression = str(result)
            display.delete(0, tk.END)
            display.insert(0, expression)
        except Exception:
            display.delete(0, tk.END)
            display.insert(0, "Enter a valid number")
            expression = ""

    elif value == "x²":
        try:
            result = float(expression) ** 2
            expression = str(result)
            display.delete(0, tk.END)
            display.insert(0, expression)
        except Exception:
            display.delete(0, tk.END)
            display.insert(0, "Enter a valid number")
            expression = ""

    else:
        expression += value
        display.delete(0, tk.END)
        display.insert(0, expression)


buttons = [
    ["C", "⌫", "%", "÷"],
    ["7", "8", "9", "×"],
    ["4", "5", "6", "-"],
    ["1", "2", "3", "+"],
    ["√", "0", ".", "="],
    ["x²", "(", ")", "π"]
]

button_frame = tk.Frame(root, bg="#202530")
button_frame.pack(expand=True, fill="both", padx=8, pady=4)

for r, row in enumerate(buttons):
    for c, value in enumerate(row):

        color = "#394354"
        if value in ["+", "-", "×", "÷", "=", "%"]:
            color = "#1677D2"
        elif value == "C":
            color = "#D94B4B"

        button = tk.Button(
            button_frame,
            text=value,
            font=("Arial", 17, "bold"),
            bg=color,
            fg="white",
            activebackground="#65758B",
            activeforeground="white",
            relief="flat",
            command=lambda v=value: press(v)
        )

        button.grid(
            row=r,
            column=c,
            sticky="nsew",
            padx=4,
            pady=4
        )

for r in range(len(buttons)):
    button_frame.rowconfigure(r, weight=1)

for c in range(4):
    button_frame.columnconfigure(c, weight=1)

root.mainloop()
